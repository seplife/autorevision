# Copiez ce fichier en .env.local et renseignez les valeurs de VOTRE projet Supabase
# (Tableau de bord Supabase → Project Settings → API).
#
# Seule la clé PUBLIQUE « anon » va ici. Elle est conçue pour être visible dans le
# navigateur : la sécurité repose sur les politiques RLS de la base.
# NE METTEZ JAMAIS la clé « service_role » dans un fichier VITE_* : elle serait
# incluse dans l'application téléchargée par les élèves.

VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=remplacez_par_la_cle_publique_anon_de_supabase

# URL publique de l'application (utilisée pour les liens de confirmation et de
# réinitialisation du mot de passe). En local : http://localhost:5173
VITE_APP_URL=http://localhost:5173
